# Copy to apps/web/.env.local and apps/api/.env — never commit real values.

# FastAPI
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000

# Next.js (public)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (service role stays on the API only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
